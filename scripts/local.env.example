# Copy to scripts/local.env (git-ignored) and fill in.
#
# The Apple Developer team the device build signs with. Xcode ▸ Settings ▸
# Accounts shows it next to your Apple ID, and it is the OU of your signing
# certificate:
#
#   security find-certificate -c "Apple Development" -p \
#     | openssl x509 -noout -subject
#   ... CN=Apple Development: you@example.com (XQU95N3575), OU=MT23DRL63Z ...
#                                              ^ developer      ^ team
#
# The id in brackets is the developer, not the team; passing it to xcodebuild
# fails with "No Account for Team". Left unset, the scripts read Xcode's
# signed-in teams and then the certificate.
# DEVELOPMENT_TEAM=XXXXXXXXXX

# Which iPhone to install onto, by name or identifier. Only needed when more
# than one device is connected. 'scripts/device.sh list' prints both.
# RUMMAGE_DEVICE=iPhone von Miro
